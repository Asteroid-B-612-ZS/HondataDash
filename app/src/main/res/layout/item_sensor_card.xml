<?xml version="1.0" encoding="utf-8"?>
<!--
    V2.9.4 real-car refinement.

    Geometry is based on the V2.9.3 merged layout that the user already tested:
      - 56dp optical extreme panel
      - 37dp reserved main-value slot
      - 15sp MAX/MIN/HI/LO labels
      - 22sp extreme values

    The important V2.9.4 change is optical separation: all extreme labels/values
    are right-aligned with a small right inset. That moves short values away from
    the main figure while preserving long values such as +10.3 at full size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/card_padding">

    <!-- Main visual field. Extreme panel is optically overlaid at the right, as in V2.9.3. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Main title + unit. MainActivity tightens both to actual ink width. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/card_title_height"
                android:orientation="horizontal"
                android:gravity="center_vertical|start">

                <io.github.asteroidb612zs.hondatadash.FittedTextView
                    android:id="@+id/labelEn"
                    style="@style/DashboardCardLabel"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"/>

                <io.github.asteroidb612zs.hondatadash.FittedTextView
                    android:id="@+id/unit"
                    style="@style/DashboardUnit"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical|start"/>
            </LinearLayout>

            <!-- Main value field. The spacer preserves V2.9.3 main-value geometry. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/valueArea"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="1dp"
                    android:paddingEnd="3dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <io.github.asteroidb612zs.hondatadash.FittedTextView
                        android:id="@+id/valueInt"
                        style="@style/DashboardMainValue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical|end"
                        android:ellipsize="none"
                        android:text="--"/>

                    <io.github.asteroidb612zs.hondatadash.FittedTextView
                        android:id="@+id/valueDec"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:text=""/>
                </FrameLayout>

                <!-- Soft center-only separator instead of a hard full-height rule. -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_extreme_divider"/>

                <View
                    android:layout_width="@dimen/extreme_value_reserve"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>

        <!--
            Right-side extreme column.
            V2.9.4: title AND value use END gravity. Short strings therefore gain
            natural air on their left instead of visually crowding the main value.
        -->
        <LinearLayout
            android:id="@+id/extremePanel"
            android:layout_width="@dimen/extreme_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:gravity="center_vertical|end"
            android:paddingStart="2dp"
            android:paddingEnd="3dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/highLabel"
                style="@style/DashboardExtremeLabel"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center_vertical|end"
                android:text="MAX"/>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/maxValue"
                style="@style/DashboardExtremeValue"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical|end"
                android:ellipsize="none"
                android:text=""/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/lowLabel"
                style="@style/DashboardExtremeLabel"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center_vertical|end"
                android:text="MIN"/>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/minValue"
                style="@style/DashboardExtremeValue"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical|end"
                android:ellipsize="none"
                android:text=""/>

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"/>
        </LinearLayout>
    </FrameLayout>

    <io.github.asteroidb612zs.hondatadash.ScaleBarView
        android:id="@+id/scaleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/range_height"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"/>

</LinearLayout>
