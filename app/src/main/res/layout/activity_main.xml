<?xml version="1.0" encoding="utf-8"?>
<!--
    Hondata Dash - 800x480 横屏车载仪表 (Honda OEM+)
    4x2 网格 + 底部爆震/辅助数据

    布局:
      Header: 转速灯 + 链路状态
      第1行: 乙醇含量 | 水温 | 进气温度 | 长期燃油调整
      第2行: 相对增压 | 空燃比 | 点火角 | 短期燃油调整
      底部: 爆震控制/缸计数 + 点火修正/限制 + 电压/油压/旁通阀/节气门
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/bg_main">

    <io.github.asteroidb612zs.hondatadash.DashboardGridLayout
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/page_margin"
        android:orientation="vertical">

    <!-- ===== 5+5 对称胶囊转速灯 / 连接状态 ===== -->
    <io.github.asteroidb612zs.hondatadash.HeaderLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_header">

        <!-- V2.0: no runtime brand mark; the 5+5 rev indicator owns the header.
             The startup curtain still renders HONDA / PERFORMANCE TELEMETRY /
             Designed by ZhouQiZhi via its own StartupBrandRenderer. -->
        <io.github.asteroidb612zs.hondatadash.ShiftLightView
            android:id="@+id/shiftLight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- DEMO 标识仅用于模拟版本，生产版隐藏 -->
        <io.github.asteroidb612zs.hondatadash.FittedTextView
            android:id="@+id/sourceName"
            style="@style/DashboardUnit"
            android:layout_width="130dp"
            android:layout_height="9dp"
            android:gravity="center_vertical|start"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="34dp"
            android:visibility="gone"
            android:textColor="@color/dash_unit"
            android:textSize="7sp"/>

        <!-- HeaderLayout 分配 20% 宽度的完整点击区，容纳最长状态 -->
        <LinearLayout
            android:id="@+id/connectionStatus"
            android:layout_width="108dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:contentDescription="蓝牙状态，轻触选择或更换 FlashPro">

            <View
                android:id="@+id/statusDot"
                android:visibility="gone"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_status_dot"/>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:text="WAIT"
                android:textColor="#FFD29922"
                android:textSize="12sp"
                android:textStyle="bold|italic"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </io.github.asteroidb612zs.hondatadash.HeaderLayout>

    <!-- ===== 第一行: ETHANOL | ECT | IAT | L.TRIM ===== -->
    <io.github.asteroidb612zs.hondatadash.AlignedRowLayout
        android:id="@+id/mainRowOne"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/main_row_gap"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/main_card_gap"
            android:layout_weight="1"/>

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/main_card_gap"
            android:layout_weight="1"/>

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/main_card_gap"
            android:layout_weight="1"/>

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </io.github.asteroidb612zs.hondatadash.AlignedRowLayout>

    <!-- ===== 第二行: MAP | A/F | IGN | S.TRIM ===== -->
    <io.github.asteroidb612zs.hondatadash.AlignedRowLayout
        android:id="@+id/mainRowTwo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/main_card_gap"
            android:layout_weight="1"/>

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/main_card_gap"
            android:layout_weight="1"/>

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/main_card_gap"
            android:layout_weight="1"/>

        <include layout="@layout/item_sensor_card"
            android:id="@+id/card7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </io.github.asteroidb612zs.hondatadash.AlignedRowLayout>

    <!-- ===== 底部行: 爆震与辅助数据，共用十二单位网格 (66dp) ===== -->
    <io.github.asteroidb612zs.hondatadash.AlignedRowLayout
        android:id="@+id/bottomRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_height"
        android:layout_marginTop="@dimen/section_gap"
        android:orientation="horizontal">

        <!-- K.C: reference layout keeps it only slightly wider than one auxiliary cell. -->
        <LinearLayout
            android:id="@+id/knockRetCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.30"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_cell"
            android:padding="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|start">

                <io.github.asteroidb612zs.hondatadash.FittedTextView
                    style="@style/DashboardCardLabel"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"
                    android:text="K.C"
                    android:textSize="15sp"/>

                <io.github.asteroidb612zs.hondatadash.FittedTextView
                    style="@style/DashboardUnit"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"
                    android:text="%"
                    android:textSize="10sp"/>
            </LinearLayout>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/knockRetValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/dash_safe"
                android:textSize="42sp"
                android:textStyle="bold|italic"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:text="0"/>
        </LinearLayout>

        <!-- CYL 1-4 (each weight=1) -->
        <include layout="@layout/item_knock_cyl"
            android:id="@+id/knock0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <include layout="@layout/item_knock_cyl"
            android:id="@+id/knock1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <include layout="@layout/item_knock_cyl"
            android:id="@+id/knock2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <include layout="@layout/item_knock_cyl"
            android:id="@+id/knock3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <!-- K.R 爆震退角 (weight=1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_bottom_cell"
            android:padding="1dp">

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                style="@style/DashboardAuxLabel"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="K.R"/>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/bottomTrimValue"
                style="@style/DashboardAuxValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"/>
        </LinearLayout>

        <!-- Knock Limit (weight=1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_bottom_cell"
            android:padding="1dp">

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                style="@style/DashboardAuxLabel"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="K.L"/>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/bottomAfmValue"
                style="@style/DashboardAuxValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"/>
        </LinearLayout>

        <!-- BAT (weight=1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_bottom_cell"
            android:padding="1dp">

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                style="@style/DashboardAuxLabel"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:text="BAT V"/>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/bottomBatValue"
                style="@style/DashboardAuxValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"/>
        </LinearLayout>

        <!-- F.P Fuel Pressure (weight=1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_bottom_cell"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <io.github.asteroidb612zs.hondatadash.MiniIconView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:tag="fuel"/>

                <io.github.asteroidb612zs.hondatadash.FittedTextView
                    style="@style/DashboardAuxLabel"
                    android:layout_width="39dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:gravity="center_vertical|start"
                    android:text="F.P bar"/>
            </LinearLayout>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/bottomFpValue"
                style="@style/DashboardAuxValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"/>
        </LinearLayout>

        <!-- W Wastegate (weight=1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_bottom_cell"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <io.github.asteroidb612zs.hondatadash.MiniIconView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:tag="turbo"/>

                <io.github.asteroidb612zs.hondatadash.FittedTextView
                    style="@style/DashboardAuxLabel"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:gravity="center_vertical|start"
                    android:text="W.G %"/>
            </LinearLayout>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/bottomWgValue"
                style="@style/DashboardAuxValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"/>
        </LinearLayout>

        <!-- T.P Throttle Plate (weight=1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_bottom_cell"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <io.github.asteroidb612zs.hondatadash.MiniIconView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:tag="throttle"/>

                <io.github.asteroidb612zs.hondatadash.FittedTextView
                    style="@style/DashboardAuxLabel"
                    android:layout_width="31dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:gravity="center_vertical|start"
                    android:text="T.P %"/>
            </LinearLayout>

            <io.github.asteroidb612zs.hondatadash.FittedTextView
                android:id="@+id/bottomTpValue"
                style="@style/DashboardAuxValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--"/>
        </LinearLayout>
    </io.github.asteroidb612zs.hondatadash.AlignedRowLayout>

    </io.github.asteroidb612zs.hondatadash.DashboardGridLayout>

    <io.github.asteroidb612zs.hondatadash.StartupOverlayView
        android:id="@+id/startupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:contentDescription="Honda Telemetry 正在启动，轻触跳过动画"/>
</FrameLayout>
