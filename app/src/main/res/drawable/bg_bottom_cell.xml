<?xml version="1.0" encoding="utf-8"?>
<!--
    V2.9.4 compact-cell frame.
    The outermost 1dp is deliberately dark. Adjacent cells therefore create a
    restrained dark seam instead of doubling two bright borders into a light fence.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF0A181D"
                android:endColor="#FF061014" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <!-- Directional top reflection. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0F38AEC5"
                android:endColor="#00000000" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <!-- Dark seam at the real cell boundary. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#FF0A171C" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <!-- Glow/core start one pixel inside the seam. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#1E44889A" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#FF4F6873" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
