<?xml version="1.0" encoding="utf-8"?>
<!--
    V2.9.4 real-car edge refinement.

    Goal: depth, not more brightness.  The card keeps a crisp 1dp structural
    edge, a weak in-bounds halo, then two extremely low-alpha directional glass
    sheens.  The top/left therefore catch more light than the bottom/right,
    avoiding the flat "three equally bright neon strokes" look on the 800x480 LCD.

    All layers remain ordinary API-17 shape/layer drawables: no blur, elevation,
    RenderEffect or software shadow is required.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep instrument glass. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF0D151D"
                android:centerColor="#FF091017"
                android:endColor="#FF060B11" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <!-- Top-biased glass reflection. Very low alpha: texture only. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#169DBDCB"
                android:centerColor="#05121E29"
                android:endColor="#00000000" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <!-- Left-side optical catch; makes the frame directional rather than neon. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0B94B2C4"
                android:endColor="#00000000" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <!-- Wide halo reduced in intensity versus V2.9.3. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="3dp" android:color="#12638499" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <!-- Blue-grey metallic transition. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#34667785" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <!-- Crisp structural line. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#FF71808C" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <!-- Inner reflected edge; intentionally faint. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#1F9AB9C9" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
